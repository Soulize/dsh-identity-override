{
  "name": "dsh-identity-override",
  "version": "0.2.0",
  "description": "Customize HARNESS_IDENTITY and find/replace text across DeepSeek Harness system prompts",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --import ./test/register-mocks.mjs --test test/*.test.js",
    "check": "node --check lib/index.js && node --check lib/identity.js && node --check lib/keyword.js && node --check lib/client.js && npm test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.1",
    "react": ">=18",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-plugin-manager": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Soulize/dsh-identity-override.git"
  }
}
